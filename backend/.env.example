# Database configurations
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/your_db
DATABASE_URL=postgresql://your_postgres_username:your_postgres_password@your_host/your_db?sslmode=require

# App settings
PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here

# Mailer configuration
EMAIL_HOSTINGER_USER=your_email@evoglobalinsight.com
EMAIL_HOSTINGER_PASSWORD=your_email_password
COMPANY_NAME=EvoGlobalInsight

# Cookie settings for VPS deployment
# COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=
