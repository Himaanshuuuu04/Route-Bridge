# App & Server Settings
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_key_here

# Database (MongoDB)
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/your_db

# Cache & Queues (Redis)
REDIS_URL=redis://localhost:6379

# Mailer configuration
EMAIL_HOSTINGER_USER=auth@yourdomain.com
EMAIL_HOSTINGER_PASSWORD=your_email_password
COMPANY_NAME=EvoGlobalInsight
ADMIN_EMAIL=admin@yourdomain.com

# Cookie settings for deployment
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=yourdomain.com
